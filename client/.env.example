# Set to the Network URL printed by npm run dev. Phones must reach this address.
# Leave empty when opening the app through a LAN or hosted URL already.
VITE_JOIN_URL=

# Sylesh's server URL, reachable from phones. Example: http://SERVER_LAN_IP:2567
# Development without an endpoint uses practice; production defaults to location.origin.
VITE_COLYSEUS_URL=

# Use npm run build:practice for standalone static practice builds.
# VITE_PRACTICE=true suppresses the production same-origin default (an explicit server URL still wins).
