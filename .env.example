# Port to listen on. Railway sets this itself.
PORT=2567

# SQLite file. In the Docker image this defaults to /data/wolfjam.db (the volume).
DB_PATH=./data/wolfjam.db

# Required in production to start or stop the swarm. Use a long random string.
OPS_TOKEN=

# Optional. Highest client count the swarm may reach (default 150).
SWARM_MAX=150

# Optional. Point the swarm at the public URL so it goes through Railway's proxy.
# SWARM_ENDPOINT=https://your-app.up.railway.app
